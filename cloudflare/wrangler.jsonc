{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cabin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "assets": {
    "directory": "../frontend/out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cabin",
      "database_id": "b5005222-4c8d-4854-be30-e9b9a373aa2d",
      "migrations_dir": "migrations"
    }
  ]
}
